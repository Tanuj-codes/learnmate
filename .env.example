# ---------------------------------------------------------------------------
# LearnMate environment configuration
# Copy to server/.env and client/.env (client only needs VITE_API_URL).
# Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon / Supabase / local Postgres)
DATABASE_URL="postgresql://learnmate:learnmate@127.0.0.1:5432/learnmate?schema=public"

# Server
NODE_ENV="development"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
TRUST_PROXY=false

# Auth - must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12
COOKIE_SECURE=false

# Reward configuration (starting values, safe to tune)
XP_LESSON_COMPLETE=10
XP_QUIZ_COMPLETE=5
XP_PER_CORRECT_ANSWER=2
XP_FLASHCARD_REVIEW=2
XP_FLASHCARD_DAILY_CAP=10
XP_GAME_COMPLETE=8
XP_DAILY_GOAL=10
FLASHCARD_REVIEW_COOLDOWN_HOURS=12

# Course knowledge leaderboard weights (must sum to 1.0)
LEADERBOARD_WEIGHT_PERFORMANCE=0.70
LEADERBOARD_WEIGHT_IMPROVEMENT=0.20
LEADERBOARD_WEIGHT_CONSISTENCY=0.10
LEADERBOARD_WINDOW_DAYS=30
LEADERBOARD_IMPROVEMENT_SCALE=5

# In-app reminders are always on. Email is opt-in and disabled by default.
EMAIL_ENABLED=false
EMAIL_PROVIDER="smtp"
EMAIL_FROM="LearnMate <no-reply@learnmate.local>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""

# Optional Resend provider (set EMAIL_PROVIDER=resend)
RESEND_API_KEY=""
