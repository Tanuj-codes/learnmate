{
  "name": "@learnmate/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --watch src --watch prisma/schema.prisma src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "db:dev": "node scripts/dev-postgres.js",
    "test": "vitest run --pool=forks --poolOptions.forks.singleFork=true",
    "test:watch": "vitest --pool=forks --poolOptions.forks.singleFork=true"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "nodemailer": "6.10.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "nodemon": "3.1.9",
    "prisma": "6.19.3",
    "supertest": "7.0.0",
    "vitest": "3.2.4"
  }
}
