# Server environment - copy from ../.env.example and fill in real values.
# The only required variables are DATABASE_URL and JWT_SECRET.

DATABASE_URL="postgresql://learnmate:learnmate@127.0.0.1:5432/learnmate?schema=public"
NODE_ENV="development"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12
COOKIE_SECURE=false

EMAIL_ENABLED=false
EMAIL_PROVIDER="smtp"
EMAIL_FROM="LearnMate <no-reply@learnmate.local>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
