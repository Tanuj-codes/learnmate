// LearnMate Prisma schema
// PostgreSQL + Prisma. Generated client is committed only via migrations, never secrets.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum ReviewRating {
  KNOWN
  NEEDS_REVISION
}

enum XpReason {
  LESSON_COMPLETE
  QUIZ_COMPLETE
  QUIZ_CORRECT_ANSWER
  FLASHCARD_REVIEW
  GAME_COMPLETE
  DAILY_GOAL
  ACHIEVEMENT
  ADMIN_ADJUSTMENT
}

enum GameType {
  MATCH_PAIRS
  TIMED_CHALLENGE
}

enum GameStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum PartnerStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  GOAL_REMINDER
  PENDING_LESSON
  ACHIEVEMENT
  WEEKLY_SUMMARY
  PARTNER
  SYSTEM
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String
  passwordHash      String
  role              Role     @default(STUDENT)
  avatarColor       String   @default("indigo")
  timezone          String   @default("UTC")
  theme             String   @default("dark")
  dailyGoalXp       Int      @default(50)
  weeklyGoalDays    Int      @default(5)
  emailNotifications Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  enrollments       Enrollment[]
  lessonProgress    LessonProgress[]
  quizAttempts      QuizAttempt[]
  flashcardReviews  FlashcardReview[]
  dailyGoals        DailyGoal[]
  xpTransactions    XPTransaction[]
  userAchievements  UserAchievement[]
  gameSessions      GameSession[]
  notifications     Notification[]
  partnerRequests   StudyPartner[] @relation("PartnerRequester")
  partnerOf         StudyPartner[] @relation("PartnerPartner")

  @@index([role])
  @@index([createdAt])
}

model Course {
  id               String      @id @default(cuid())
  slug             String      @unique
  title            String
  tagline          String
  description      String      @db.Text
  category         String
  difficulty       Difficulty  @default(BEGINNER)
  estimatedMinutes Int         @default(120)
  published        Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  topics           Topic[]
  lessons          Lesson[]
  quizzes          Quiz[]
  flashcards       Flashcard[]
  enrollments      Enrollment[]
  gameSessions     GameSession[]
  xpTransactions   XPTransaction[]

  @@index([published, category])
}

model Topic {
  id       String @id @default(cuid())
  courseId String
  title    String
  order    Int

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@unique([courseId, order])
  @@index([courseId])
}

model Lesson {
  id               String   @id @default(cuid())
  courseId         String
  topicId          String?
  title            String
  summary          String
  content          String   @db.Text
  order            Int
  estimatedMinutes Int      @default(10)
  xpReward         Int      @default(10)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic            Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  progress         LessonProgress[]

  @@unique([courseId, order])
  @@index([courseId])
  @@index([topicId])
}

model Enrollment {
  id             String   @id @default(cuid())
  userId         String
  courseId       String
  enrolledAt     DateTime @default(now())
  lastAccessedAt DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([userId])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completedAt DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model Quiz {
  id          String     @id @default(cuid())
  courseId    String
  title       String
  description String
  difficulty  Difficulty @default(BEGINNER)
  passingScore Int       @default(60)
  timeLimitSec Int?      @default(900)
  order       Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions   Question[]
  attempts    QuizAttempt[]

  @@unique([courseId, title])
  @@index([courseId])
}

model Question {
  id           String     @id @default(cuid())
  quizId       String
  prompt       String     @db.Text
  options      Json
  correctIndex Int
  explanation  String     @db.Text
  topic        String
  difficulty   Difficulty @default(BEGINNER)
  order        Int
  createdAt    DateTime   @default(now())

  quiz         Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers      QuizAnswer[]

  @@unique([quizId, order])
  @@index([quizId])
}

model QuizAttempt {
  id            String        @id @default(cuid())
  userId        String
  quizId        String
  status        AttemptStatus @default(IN_PROGRESS)
  attemptNumber Int
  questionIds   Json
  totalCount    Int
  correctCount  Int           @default(0)
  score         Int?
  startedAt     DateTime      @default(now())
  submittedAt   DateTime?
  xpAwarded     Int           @default(0)
  verified      Boolean       @default(true)

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz          Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers       QuizAnswer[]

  @@unique([userId, quizId, attemptNumber])
  @@index([userId, submittedAt])
  @@index([quizId, submittedAt])
  @@index([userId, quizId, status])
}

model QuizAnswer {
  id            String   @id @default(cuid())
  attemptId     String
  questionId    String
  selectedIndex Int?
  isCorrect     Boolean  @default(false)
  answeredAt    DateTime @default(now())

  attempt       QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model Flashcard {
  id        String   @id @default(cuid())
  courseId  String
  topic     String
  front     String   @db.Text
  back      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  reviews   FlashcardReview[]

  @@unique([courseId, front])
  @@index([courseId])
}

model FlashcardReview {
  id           String       @id @default(cuid())
  userId       String
  flashcardId  String
  rating       ReviewRating
  intervalDays Int          @default(1)
  repetitions  Int          @default(0)
  dueAt        DateTime
  reviewedAt   DateTime     @default(now())
  xpAwarded    Int          @default(0)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard    Flashcard    @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
  @@index([userId, flashcardId, reviewedAt])
  @@index([flashcardId])
}

model DailyGoal {
  id           String    @id @default(cuid())
  userId       String
  date         DateTime  @db.Date
  targetXp     Int
  xpEarned     Int       @default(0)
  completed    Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model XPTransaction {
  id             String   @id @default(cuid())
  userId         String
  courseId       String?
  amount         Int
  reason         XpReason
  sourceType     String
  sourceId       String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, reason, createdAt])
  @@index([courseId, userId])
}

model Achievement {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  description   String
  icon          String   @default("Award")
  criteriaType  String
  criteriaValue Int
  xpReward      Int      @default(25)
  tier          String   @default("BRONZE")
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

// A single row models the relationship. Each party has their own consent flag
// controlling whether their progress is shared with the other party.
model StudyPartner {
  id                String        @id @default(cuid())
  requesterId       String
  partnerId         String
  status            PartnerStatus @default(PENDING)
  requesterConsent  Boolean       @default(true)
  partnerConsent    Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  requester         User          @relation("PartnerRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  partner           User          @relation("PartnerPartner", fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([requesterId, partnerId])
  @@index([partnerId, status])
  @@index([requesterId, status])
}

model GameSession {
  id          String     @id @default(cuid())
  userId      String
  courseId    String
  gameType    GameType
  status      GameStatus @default(IN_PROGRESS)
  state       Json
  startedAt   DateTime   @default(now())
  completedAt DateTime?
  score       Int?
  maxScore    Int
  durationMs  Int?
  verified    Boolean    @default(false)
  xpAwarded   Int        @default(0)

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([courseId, gameType])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}
